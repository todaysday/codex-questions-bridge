# PicoClaw gateway for the Codex Questions Bridge consultant. Install as /etc/systemd/system/picoclaw-gateway.service.
# One long-running gateway serves every consultant session (pico channel); it is a separate process with its own limits.
[Unit]
Description=PicoClaw gateway (Codex Questions Bridge consultant)
# The Bridge's MCP server must listen first: PicoClaw connects to it while it starts.
After=network-online.target cqb.service
Wants=network-online.target

[Service]
Type=simple
User=cqb-pico
Environment=PICOCLAW_HOME=/var/lib/picoclaw
Environment=HOME=/var/lib/picoclaw
# CQB_MCP_TOKEN and CQB_MCP_URL live in /etc/cqb/picoclaw.env (root:cqb-pico 0640); same token as in /etc/cqb/cqb.env.
# The scope hook is a child of the gateway and inherits this environment: that is how it reaches the Bridge.
EnvironmentFile=/etc/cqb/picoclaw.env
ExecStart=/opt/picoclaw/bin/picoclaw gateway
Restart=always
RestartSec=3
StateDirectory=picoclaw

# Own limits. PicoClaw is a Go process plus the small hook; it must never starve the bot or the Codex daemon.
CPUWeight=100
MemoryMax=512M
MemorySwapMax=0
TasksMax=128

# Hardening: it needs loopback sockets (Bridge), the model gateway and its home directory, and the public web for web_fetch.
# The web is why the server also gets a systemd drop-in with IPAddressDeny/IPAddressAllow that keeps private and tailnet
# ranges out of reach (redirects and DNS rebinding): see deploy/picoclaw/egress.conf.example. It is never in the repo
# with real addresses and is not installed by deploy/update.sh.
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/lib/picoclaw
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
UMask=0077

[Install]
WantedBy=multi-user.target
